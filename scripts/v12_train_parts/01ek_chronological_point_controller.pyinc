# Gate-aligned, exact-maturity chronological point controller for V12.
# Selection/calibration use pre-blind labels only. 80-85% supplies exact-maturity rolling folds,
# safe early 85-90% dates add external validation/refit, late 85-90% is conformal-only, and
# 90-100% is never read for model-family selection or calibration.
_chrono_apply_before=apply_calibration
_V12_PRIMARY_PREBLIND_CALIBRATION=None


def _chrono_horizon():return max(1,int(globals().get('V12_ACTIVE_HORIZON',1)))
def _chrono_magnitude_floor(h):return ({1:.05,2:.07,3:.08,4:.09,5:.10}.get(int(h),.08),{1:.04,2:.05,3:.06,4:.07,5:.08}.get(int(h),.06))


def _chrono_date_split(cal_dates,conform_dates,conform_maturity=None):
    fd=np.asarray(cal_dates,dtype=object).astype(str);vd=np.asarray(conform_dates,dtype=object).astype(str);fit_days=np.asarray(sorted(set(fd)),dtype=object);u=np.asarray(sorted(set(vd)),dtype=object)
    if len(fit_days)<8 or len(u)<4:return None
    cut=max(2,min(len(u)-2,len(u)//2));val_days=u[:cut];conf_days=u[cut:]
    if str(fit_days[-1])>=str(val_days[0]) or str(val_days[-1])>=str(conf_days[0]):raise RuntimeError('calibration origin-date chronology overlap')
    if conform_maturity is not None:
        mm=np.asarray(conform_maturity,dtype=object).astype(str)
        if len(mm)!=len(vd):raise RuntimeError('conformal maturity alignment mismatch')
        conf_start=str(conf_days[0]);safe=[]
        for day in val_days:
            q=np.where(vd==str(day))[0]
            if len(q) and bool(np.all(mm[q]<conf_start)):safe.append(str(day))
        val_days=np.asarray(safe,dtype=object)
    if len(val_days)<2:return None
    iv=np.where(np.isin(vd,val_days))[0];ic=np.where(np.isin(vd,conf_days))[0]
    return None if not len(iv) or not len(ic) else {'validationIndex':iv,'conformalIndex':ic,'fitDays':fit_days,'validationDays':val_days,'conformalDays':conf_days}


def _chrono_fit_quantile(y,score):
    yy=np.asarray(y,float);ss=np.asarray(score,float);good=np.isfinite(yy)&np.isfinite(ss);yy=yy[good];ss=ss[good]
    if len(yy)<300 or float(np.std(ss))<1e-12:raise RuntimeError(f'rolling point fit too small/degenerate: {len(yy)}')
    x=ss.reshape(-1,1);models={};methods=[]
    for a in (.2,.5,.8):m,method=_fit_quantile_model(a,x,yy);models[a]=m;methods.append(method)
    layer=_QuantileLayer(models,methods[0] if len(set(methods))==1 else '+'.join(sorted(set(methods))),len(yy),float(np.min(ss)),float(np.max(ss)));iso=IsotonicRegression(y_min=.02,y_max=.98,out_of_bounds='clip');iso.fit(ss,(yy>0).astype(float));return layer,iso


def _chrono_daily_rank_scale(y,score,dates):
    yy=np.asarray(y,float);ss=np.asarray(score,float);dd=np.asarray(dates,dtype=object);good=np.isfinite(yy)&np.isfinite(ss);yy=yy[good];ss=ss[good];dd=dd[good]
    if len(yy)<300:return None
    rr=_xsec_rank_signal(ss,dd)
    if float(np.std(rr))<1e-10:return None
    ratio=float(np.std(yy)/max(np.std(rr),1e-10));upper=float(min(.20,max(.004,2.5*ratio)));grid=np.unique(np.concatenate([np.linspace(0.0,min(.04,upper),81),np.geomspace(max(.001,min(.04,upper)),upper,48) if upper>.04 else np.asarray([],float)]));days=sorted(set(dd.astype(str)));rows=[]
    for g in grid:
        pp=float(g)*rr;dl=[float(np.mean(np.abs(yy[dd.astype(str)==day]-pp[dd.astype(str)==day]))) for day in days if int(np.sum(dd.astype(str)==day))>=12]
        if dl:rows.append((float(g),float(np.mean(dl)),float(np.std(pp))))
    if not rows:return None
    best=min(rows,key=lambda z:(z[1],z[0]));return {'kind':'RANK_ONLY','scale':best[0],'fitRows':int(len(yy)),'fitDates':int(len(days)),'equalDateMAE':best[1],'forecastStd':best[2],'gridMin':float(np.min(grid)),'gridMax':float(np.max(grid)),'gridN':int(len(grid)),'objective':'PREBLIND_EQUAL_DATE_L1_WITHIN_ORIGIN_RANK','sealedLabelsUsed':0}


def _chrono_fit_bundle(y,score,dates):
    yy=np.asarray(y,float);ss=np.asarray(score,float);dd=np.asarray(dates,dtype=object);layer,iso=_chrono_fit_quantile(yy,ss);_,q50,_=layer.predict(ss);qscale,q_n,q_audit=_select_return_shrink(yy,q50);score_scale,s_n,s_audit=_select_return_shrink(yy,ss);median_map=_fit_binned_monotone_median(ss,yy,15);affine=_fit_robust_affine_score(ss,yy);origin_scale=_fit_robust_origin_scale(ss,yy);rank=_xsec_rank_signal(ss,dd);rank_fit=_xsec_positive_scale(yy,np.asarray(q50,float)*qscale,rank);center=_isotonic_half_center(iso,ss) if '_isotonic_half_center' in globals() else float(np.median(ss));market_fit=_xsec_market_rank_fit(yy,ss,dd,center);rank_only=_chrono_daily_rank_scale(yy,ss,dd)
    return {'layer':layer,'iso':iso,'qscale':float(qscale),'qN':int(q_n),'qAudit':q_audit,'scoreScale':float(score_scale),'scoreN':int(s_n),'scoreAudit':s_audit,'medianMap':median_map,'affine':affine,'originScale':origin_scale,'rankFit':rank_fit,'marketFit':market_fit,'rankOnly':rank_only,'fitRows':int(len(yy)),'fitDates':int(len(set(dd.astype(str))))}


def _chrono_bundle_predictions(bundle,score,dates):
    ss=np.asarray(score,float);dd=np.asarray(dates,dtype=object);lo0,q50,hi0=bundle['layer'].predict(ss);g=float(bundle['qscale']);lo=np.asarray(lo0,float)*g;hi=np.asarray(hi0,float)*g;out={'Q50':np.asarray(q50,float)*g,'DIRECT_SCORE':_clip_between(ss*float(bundle['scoreScale']),lo,hi)}
    if bundle.get('medianMap') is not None:out['BINNED_MONOTONE_MEDIAN']=_clip_between(_predict_binned_monotone(bundle['medianMap'],ss),lo,hi)
    if bundle.get('affine') is not None:out['ROBUST_AFFINE_SCORE']=_clip_between(_affine_predict(bundle['affine'],ss),lo,hi)
    if bundle.get('originScale') is not None:out['ROBUST_ORIGIN_SCALE']=_clip_between(_affine_predict(bundle['originScale'],ss),lo,hi)
    rank=_xsec_rank_signal(ss,dd)
    if bundle.get('rankFit') is not None:out['XSEC_BASE_PLUS_RANK']=_clip_between(out['Q50']+float(bundle['rankFit']['scale'])*rank,lo,hi)
    if bundle.get('marketFit') is not None:out['XSEC_MARKET_PLUS_RANK']=_clip_between(_xsec_apply_model({'kind':'MARKET_PLUS_RANK',**bundle['marketFit']},ss,dd),lo,hi)
    if bundle.get('rankOnly') is not None:out['XSEC_RANK_ONLY']=_clip_between(float(bundle['rankOnly']['scale'])*rank,lo,hi)
    return out


def _chrono_daily_edge(y,pred,dates):
    yy=np.asarray(y,float);pp=np.asarray(pred,float);dd=np.asarray(dates,dtype=object);good=np.isfinite(yy)&np.isfinite(pp);yy=yy[good];pp=pp[good];dd=dd[good];vals=[]
    for day in sorted(set(dd.astype(str))):
        q=dd.astype(str)==day
        if int(np.sum(q))>=12:vals.append(float(np.mean(np.abs(yy[q])-np.abs(yy[q]-pp[q]))))
    if not vals:return {'days':0,'mean':0.0,'positiveDayShare':0.0,'bootstrap90':[None,None],'blockLength':0}
    a=np.asarray(vals,float)
    if '_moving_block_bootstrap_mean' in globals():ci,block=_moving_block_bootstrap_mean(a,reps=1400)
    else:
        n=len(a);block=max(2,min(6,int(round(n**.33))));starts=np.arange(0,max(1,n-block+1));rng=np.random.default_rng(9127+n);boots=[]
        for _ in range(1400):
            draw=[]
            while len(draw)<n:
                s=int(rng.choice(starts));draw.extend(a[s:s+block].tolist())
            boots.append(float(np.mean(draw[:n])))
        ci=[float(np.quantile(boots,.05)),float(np.quantile(boots,.95))]
    return {'days':int(len(a)),'mean':float(np.mean(a)),'positiveDayShare':float(np.mean(a>0)),'bootstrap90':ci,'blockLength':int(block)}


def _chrono_oos_metric(y,pred,dates,h):
    yy=np.asarray(y,float);pp=np.asarray(pred,float);dd=np.asarray(dates,dtype=object);m=_point_candidate_metrics(yy,pp);rs=rank_stats(yy,pp,dd);daily=_chrono_daily_edge(yy,pp,dd);p90a=float(np.quantile(np.abs(yy),.90)) if len(yy) else 0.;p90p=float(np.quantile(np.abs(pp),.90)) if len(pp) else 0.;min_disp,min_p90=_chrono_magnitude_floor(h);ci=daily.get('bootstrap90') or [None,None];gate=bool(daily.get('days',0)>=20 and daily.get('mean',0)>0 and daily.get('positiveDayShare',0)>=.50 and isinstance(ci[0],(int,float)) and finite(ci[0]) and float(ci[0])>0 and float(m.get('dispersionRatio') or 0)>=min_disp and p90p/(p90a or 1e-12)>=min_p90 and float(rs.get('ic') or 0)>.01)
    return {**m,'dailyMAEEdge':daily,'rankIC':float(rs.get('ic') or 0),'p90MagnitudeRatio':p90p/(p90a or 1e-12),'minimumDispersionRatio':min_disp,'minimumP90MagnitudeRatio':min_p90,'gateAlignedPass':gate,'sealedLabelsUsed':0}


def _chrono_rolling_folds(fit_days,external_days):
    fd=np.asarray(fit_days,dtype=object)
    if len(fd)<12:return []
    init=max(6,min(len(fd)-6,len(fd)//3));parts=[np.asarray(x,dtype=object) for x in np.array_split(fd[init:],3) if len(x)];folds=[{'validationDays':x,'kind':'INTERNAL_80_85'} for x in parts]
    if len(external_days):folds.append({'validationDays':np.asarray(external_days,dtype=object),'kind':'EXTERNAL_EARLY_85_90'})
    return folds


def _chrono_select_family(fy,fs,fd,fm,cy,cs,cd,split):
    folds=_chrono_rolling_folds(split['fitDays'],split['validationDays'])
    if len(folds)<3:raise RuntimeError('insufficient rolling-origin point-selection folds')
    fm=np.asarray(fm,dtype=object).astype(str)
    if len(fm)!=len(fy):raise RuntimeError('primary calibration maturity alignment mismatch')
    agg={};fold_audit=[]
    for f in folds:
        val_start=str(f['validationDays'][0])
        if f['kind']=='INTERNAL_80_85':
            tr=(fd.astype(str)<val_start)&(fm<val_start);va=np.isin(fd.astype(str),f['validationDays'].astype(str));ty,ts,td=fy[tr],fs[tr],fd[tr];vy,vs,vd=fy[va],fs[va],fd[va]
        else:
            tr=np.ones(len(fy),dtype=bool);va=np.isin(cd.astype(str),f['validationDays'].astype(str));ty,ts,td=fy,fs,fd;vy,vs,vd=cy[va],cs[va],cd[va]
        max_maturity=str(max(fm[tr])) if np.any(tr) else None
        if max_maturity is not None and max_maturity>=val_start:raise RuntimeError(f'rolling maturity leak: {max_maturity} >= {val_start}')
        bundle=_chrono_fit_bundle(ty,ts,td);preds=_chrono_bundle_predictions(bundle,vs,vd);fold_audit.append({'kind':f['kind'],'trainOriginEnd':str(max(td.astype(str))) if len(td) else None,'maxTrainLabelMaturity':max_maturity,'validationDateRange':[str(f['validationDays'][0]),str(f['validationDays'][-1])],'trainRows':int(len(ty)),'validationRows':int(len(vy)),'exactMaturityPurged':True,'futureLabelsUsed':0,'families':sorted(preds)})
        for name,p in preds.items():
            z=agg.setdefault(name,{'y':[],'p':[],'d':[],'folds':0});z['y'].append(np.asarray(vy,float));z['p'].append(np.asarray(p,float));z['d'].append(np.asarray(vd,dtype=object));z['folds']+=1
    metrics={name:_chrono_oos_metric(np.concatenate(z['y']),np.concatenate(z['p']),np.concatenate(z['d']),_chrono_horizon()) for name,z in agg.items() if z['folds']==len(folds)}
    if 'Q50' not in metrics:raise RuntimeError('rolling selector lost Q50 incumbent')
    eligible=[n for n,m in metrics.items() if m.get('gateAlignedPass') is True];complexity={'Q50':0,'XSEC_RANK_ONLY':1,'ROBUST_ORIGIN_SCALE':2,'BINNED_MONOTONE_MEDIAN':3,'DIRECT_SCORE':4,'XSEC_BASE_PLUS_RANK':5,'XSEC_MARKET_PLUS_RANK':6,'ROBUST_AFFINE_SCORE':7}
    def key(n):
        ci=metrics[n]['dailyMAEEdge'].get('bootstrap90') or [None,None];lower=float(ci[0]) if isinstance(ci[0],(int,float)) and finite(ci[0]) else -1e9;return (lower,float(metrics[n]['dailyMAEEdge'].get('mean') or -1e9),float(metrics[n].get('rankIC') or -1e9),-complexity.get(n,99))
    chosen=max(eligible,key=key) if eligible else max(metrics,key=key);return chosen,metrics,fold_audit,eligible


def _chrono_refit_selected_point(base,mode,y,score,dates):
    out=dict(base);yy=np.asarray(y,float);ss=np.asarray(score,float);dd=np.asarray(dates,dtype=object)
    if mode=='DIRECT_SCORE':g,n,a=_select_return_shrink(yy,ss);out.update(scoreScale=float(g),scoreN=int(n),scoreAudit=a)
    elif mode=='BINNED_MONOTONE_MEDIAN':out['medianMap']=_fit_binned_monotone_median(ss,yy,15)
    elif mode=='ROBUST_AFFINE_SCORE':out['affine']=_fit_robust_affine_score(ss,yy)
    elif mode=='ROBUST_ORIGIN_SCALE':out['originScale']=_fit_robust_origin_scale(ss,yy)
    elif mode=='XSEC_BASE_PLUS_RANK':_,q50,_=base['layer'].predict(ss);out['rankFit']=_xsec_positive_scale(yy,np.asarray(q50,float)*float(base['qscale']),_xsec_rank_signal(ss,dd))
    elif mode=='XSEC_MARKET_PLUS_RANK':out['marketFit']=_xsec_market_rank_fit(yy,ss,dd,_isotonic_half_center(base['iso'],ss) if '_isotonic_half_center' in globals() else float(np.median(ss)))
    elif mode=='XSEC_RANK_ONLY':out['rankOnly']=_chrono_daily_rank_scale(yy,ss,dd)
    out['pointRefitRows']=int(len(yy));out['pointRefitDates']=int(len(set(dd.astype(str))));return out


def _chrono_install_family(layer,b,mode):
    layer.returnShrink=float(b['qscale']);layer.shrinkSelectionN=int(b['qN']);layer.shrinkSelectionAudit=b['qAudit'];layer.pointMode=str(mode);layer.pointScoreScale=float(b['scoreScale']);layer.pointBinnedMedian=b.get('medianMap');layer.pointAffineModel=None;layer.pointDeadband=0.;layer.pointXsecModel=None;layer.pointRankOnlyModel=None
    if mode=='ROBUST_AFFINE_SCORE':layer.pointAffineModel=b.get('affine')
    elif mode=='ROBUST_ORIGIN_SCALE':layer.pointAffineModel=b.get('originScale')
    elif mode=='XSEC_BASE_PLUS_RANK':
        rf=b.get('rankFit');
        if rf is None:raise RuntimeError('XSEC_BASE_PLUS_RANK refit failed')
        layer.pointXsecModel={'kind':'BASE_PLUS_RANK','residualScale':float(rf['scale']),'fit':rf}
    elif mode=='XSEC_MARKET_PLUS_RANK':
        mf=b.get('marketFit');
        if mf is None:raise RuntimeError('XSEC_MARKET_PLUS_RANK refit failed')
        layer.pointXsecModel={'kind':'MARKET_PLUS_RANK',**mf}
    elif mode=='XSEC_RANK_ONLY':
        if b.get('rankOnly') is None:raise RuntimeError('XSEC_RANK_ONLY refit failed')
        layer.pointRankOnlyModel=b['rankOnly']
    return layer


def calibrate(cal_y,cal_score,conform_y,conform_score,cal_dates=None,conform_dates=None):
    global _V12_PRIMARY_PREBLIND_CALIBRATION
    if cal_dates is None or conform_dates is None:
        layer,iso,_=_point_base_quantile_calibrate(cal_y,cal_score,conform_y,conform_score);return layer,iso,0.
    supplied=np.asarray(conform_dates,dtype=object).astype(str);d90=str(globals().get('V12_CURRENT_SEALED_START') or '')
    if d90 and len(supplied) and bool(np.any(supplied>=d90)):
        if _V12_PRIMARY_PREBLIND_CALIBRATION is None:raise RuntimeError('sealed calibration attempted before preblind calibration cache')
        layer,iso,qadj=_V12_PRIMARY_PREBLIND_CALIBRATION;a=getattr(layer,'pointSelectionAudit',None)
        if isinstance(a,dict):a['deploymentCalibrationReuse']='FROZEN_PREBLIND_LAYER_NO_SEALED_LABEL_READ';a['sealedLabelsUsed']=0
        return layer,iso,qadj
    fy=np.asarray(cal_y,float);fs=np.asarray(cal_score,float);fd=np.asarray(cal_dates,dtype=object);cy=np.asarray(conform_y,float);cs=np.asarray(conform_score,float);cd=np.asarray(conform_dates,dtype=object)
    if not (len(fy)==len(fs)==len(fd)) or not (len(cy)==len(cs)==len(cd)):raise RuntimeError('chronological calibration alignment mismatch')
    fm_raw=globals().get('V12_PRIMARY_CAL_A_MATURITY');cm_raw=globals().get('V12_PRIMARY_CAL_B_MATURITY');fm=np.asarray([] if fm_raw is None else fm_raw,dtype=object);cm=np.asarray([] if cm_raw is None else cm_raw,dtype=object)
    if len(fm)!=len(fy) or len(cm)!=len(cy):raise RuntimeError(f'exact maturity arrays missing/misaligned: {len(fm)}/{len(fy)} {len(cm)}/{len(cy)}')
    split=_chrono_date_split(fd,cd,cm)
    if split is None or len(fy)<300 or len(cy)<300:raise RuntimeError('chronological rolling calibration requires adequate rows/whole dates')
    mode,metrics,folds,eligible=_chrono_select_family(fy,fs,fd,fm,cy,cs,cd,split);iv=split['validationIndex'];ic=split['conformalIndex'];base=_chrono_fit_bundle(fy,fs,fd);refit_y=np.concatenate([fy,cy[iv]]);refit_s=np.concatenate([fs,cs[iv]]);refit_d=np.concatenate([fd,cd[iv]]);b=_chrono_refit_selected_point(base,mode,refit_y,refit_s,refit_d);layer=base['layer'];iso=base['iso'];_chrono_install_family(layer,b,mode)
    loC,_,hiC=layer.predict(cs[ic]);g=float(base['qscale']);loC=np.asarray(loC,float)*g;hiC=np.asarray(hiC,float)*g;yy=cy[ic];nonconf=np.maximum.reduce([loC-yy,yy-hiC,np.zeros(len(yy))]) if len(yy) else np.asarray([],float);target=.60;qlevel=min(1.,math.ceil((len(nonconf)+1)*target)/max(1,len(nonconf)));qadj=float(np.quantile(nonconf,qlevel,method='higher')) if len(nonconf) else 0.
    layer.conformalTarget=target;layer.conformalN=int(len(nonconf));layer.calibrationSplitPolicy='80-85% scenario calibration + exact-maturity rolling point evaluation; safe early whole 85-90% dates external-validate/refit the selected point family; late whole 85-90% dates conformal-only; 90-100% remains sealed.';layer.pointSelectionAudit={'method':'CHRONOLOGICAL_ORIGIN_DATE_POINT_SELECTION_V2','selectionEngine':'EXACT_MATURITY_PURGED_EXPANDING_ROLLING_ORIGIN__DAILY_MAE_MOVING_BLOCK__GATE_ALIGNED','objectiveAlignment':'daily MAE edge, moving-block lower90, ranking, and unchanged horizon magnitude floors','fitRows':int(len(fy)),'externalValidationRows':int(len(iv)),'pointRefitRows':int(len(refit_y)),'conformalRows':int(len(ic)),'fitDates':int(len(split['fitDays'])),'externalValidationDates':int(len(split['validationDays'])),'conformalDates':int(len(split['conformalDays'])),'fitDateRange':[str(split['fitDays'][0]),str(split['fitDays'][-1])],'externalValidationDateRange':[str(split['validationDays'][0]),str(split['validationDays'][-1])],'conformalDateRange':[str(split['conformalDays'][0]),str(split['conformalDays'][-1])],'dateDisjoint':True,'rowOrderIndependent':True,'wholeOriginValidationDatesOnly':True,'exactLabelMaturityPurged':True,'rollingFolds':folds,'candidateMetrics':metrics,'eligibleGateAlignedFamilies':eligible,'selectedFamily':str(mode),'selectedFamilyPreblindGateAlignedPass':bool(mode in eligible),'rankOnlyCandidate':{'sameOriginOnly':True,'zeroMedianByConstruction':True,'positiveScaleOnly':True,'marketDriftIntercept':False},'scenarioFitRows':int(base['fitRows']),'scenarioFitDates':int(base['fitDates']),'scenarioRefitOnValidation':False,'q50ScaleAudit':base['qAudit'],'directScoreScaleAudit':b['scoreAudit'],'sealedLabelsUsed':0,'reason':'selection matches final daily bootstrap/magnitude evidence across exact-maturity chronological folds; scenario calibration stays on 80-85 and sealed labels are never read for selection/calibration'}
    result=(layer,iso,max(0.,qadj))
    if bool(globals().get('V12_PRIMARY_CALIBRATION_PENDING',False)):_V12_PRIMARY_PREBLIND_CALIBRATION=result;globals()['V12_PRIMARY_CALIBRATION_PENDING']=False
    return result


def apply_calibration(score,scen,iso,qadj,origin_dates=None):
    mode=str(getattr(scen,'pointMode','')) if isinstance(scen,_QuantileLayer) else ''
    if mode!='XSEC_RANK_ONLY':return _chrono_apply_before(score,scen,iso,qadj,origin_dates)
    if origin_dates is None:raise RuntimeError('XSEC_RANK_ONLY requires explicit same-origin dates')
    ss=np.asarray(score,float);dd=np.asarray(origin_dates,dtype=object);p=np.asarray(iso.predict(ss),float);lo0,_,hi0=scen.predict(ss);g=float(getattr(scen,'returnShrink',1.));lo=np.asarray(lo0,float)*g;hi=np.asarray(hi0,float)*g;rank=_xsec_rank_signal(ss,dd);point=float((getattr(scen,'pointRankOnlyModel',None) or {}).get('scale',0.))*rank;point=_clip_between(point,lo,hi);return p,np.asarray(point,float),lo-float(qadj),hi+float(qadj),np.full(len(point),int(scen.n),dtype=int)


def _chrono_split_selftest():
    cal=np.asarray(['2026-01-01','2026-01-02','2026-01-03','2026-01-04','2026-01-05','2026-01-06','2026-01-07','2026-01-08']*3,dtype=object);days=['2026-01-09','2026-01-10','2026-01-11','2026-01-12','2026-01-13','2026-01-14'];con=np.asarray(days*3,dtype=object);mat=np.asarray(['2026-01-10','2026-01-10','2026-01-13','2026-01-13','2026-01-14','2026-01-14']*3,dtype=object);z=_chrono_date_split(cal,con,mat)
    if z is None:raise RuntimeError('chronology split selftest produced no split')
    vd=set(con[z['validationIndex']].astype(str));cd=set(con[z['conformalIndex']].astype(str))
    if vd&cd or max(vd)>=min(cd):raise RuntimeError('chronology split selftest overlap/order failure')
    for day in vd:
        if int(np.sum(con[z['validationIndex']].astype(str)==day))!=int(np.sum(con.astype(str)==day)):raise RuntimeError('chronology split selftest fragmented validation date')


def _chrono_rank_only_selftest():
    s=np.asarray([.1,.2,.3,.4,1.,2.,3.,4.],float);d=np.asarray(['A']*4+['B']*4,dtype=object);r=_xsec_rank_signal(s,d)
    if abs(float(np.mean(r[d=='A'])))>1e-12 or abs(float(np.mean(r[d=='B'])))>1e-12:raise RuntimeError('rank-only zero-mean regression')
    perm=np.asarray([3,1,0,2,7,4,6,5]);rp=_xsec_rank_signal(s[perm],d[perm]);back=np.empty_like(rp);back[perm]=rp
    if not np.allclose(r,back):raise RuntimeError('rank-only row-order regression')


_chrono_split_selftest();_chrono_rank_only_selftest()

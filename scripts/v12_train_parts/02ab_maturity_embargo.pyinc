V12_CURRENT_SEALED_START=None
V12_PRIMARY_CALIBRATION_PENDING=False
V12_PRIMARY_CAL_A_MATURITY=None
V12_PRIMARY_CAL_B_MATURITY=None

def interval_masks(D,dates):
    global V12_CURRENT_SEALED_START,V12_PRIMARY_CALIBRATION_PENDING,V12_PRIMARY_CAL_A_MATURITY,V12_PRIMARY_CAL_B_MATURITY
    h=max(1,int(globals().get('V12_ACTIVE_HORIZON',1)));Maturity=label_maturity_array(h);n=len(dates);d80=dates[int(.80*n)];d85=dates[int(.85*n)];d90=dates[int(.90*n)]
    calA=(D>=d80)&(D<d85)&(Maturity<d85)
    calB=(D>=d85)&(D<d90)&(Maturity<d90)
    # Preserve row-aligned exact symbol-specific T+h maturity for calibration rows. Rolling-origin
    # point-family evaluation purges every fold by the actual maturity date, never an h-day proxy.
    V12_PRIMARY_CAL_A_MATURITY=np.asarray(Maturity[calA],dtype=object)
    V12_PRIMARY_CAL_B_MATURITY=np.asarray(Maturity[calB],dtype=object)
    # Freeze the exact 90% boundary. Any later deployment-calibration call that reaches this block
    # must reuse the already-fitted pre-blind calibration and must not read 90-100% labels.
    V12_CURRENT_SEALED_START=str(d90);V12_PRIMARY_CALIBRATION_PENDING=True
    return {'calA':calA,'calB':calB,'audit':D>=d90}

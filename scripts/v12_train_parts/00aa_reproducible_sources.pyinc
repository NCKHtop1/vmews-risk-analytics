get_index_history = _repro_get_index_history
source_audit_summary = _repro_source_audit_summary

print(
    json.dumps(
        {
            "v12ResearchSourceMode": "IMMUTABLE_FROZEN_SNAPSHOT",
            "runtimeProviderSwitching": False,
            "runtimeNetworkPriceFetch": False,
            "fingerprintRequired": True,
        },
        ensure_ascii=False,
    ),
    flush=True,
)

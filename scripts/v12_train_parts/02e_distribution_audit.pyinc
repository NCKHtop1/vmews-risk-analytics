_pbo_fit_horizon_before_distribution_audit=fit_horizon

def fit_horizon(X,y,D,dates,h,idx_by_expert):
    before=len(CALIBRATION_CAPTURE);z=_pbo_fit_horizon_before_distribution_audit(X,y,D,dates,h,idx_by_expert);new=CALIBRATION_CAPTURE[before:];sealed_runtime=new[0] if new else None;layer=z.get('scenarioCalibration');method=getattr(layer,'method','LEGACY_EMPIRICAL_BUCKET');z['distributionAudit']={'method':method,'quantiles':[.2,.5,.8] if hasattr(layer,'models') else None,'calibrationRows':getattr(layer,'n',None),'conformalRows':getattr(layer,'conformalN',None),'targetCoverage':getattr(layer,'conformalTarget',None),'conformalAdjustment':z.get('conformalAdjustment'),'expectedReturnDefinition':'conditional median q50','priceConversion':'raw close * exp(q50 log return)'};z['_sealedCalibrationRuntime']=sealed_runtime;return z

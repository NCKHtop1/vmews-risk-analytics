_prepare_articles_before_exact_benchmark=prepare_articles
_V12_INDEX_BY_DATE={}
_V12_INDEX_DATES=[]

def _benchmark_exact_date(index_rows,origin_date,target_date):
    if not index_rows or not origin_date or not target_date:return None
    global _V12_INDEX_BY_DATE,_V12_INDEX_DATES
    if not _V12_INDEX_BY_DATE:
        _V12_INDEX_BY_DATE={str(r.get('date'))[:10]:r for r in index_rows if r.get('date')};_V12_INDEX_DATES=sorted(_V12_INDEX_BY_DATE)
    arow=_V12_INDEX_BY_DATE.get(str(origin_date)[:10]);brow=_V12_INDEX_BY_DATE.get(str(target_date)[:10])
    if not arow or not brow:return None
    a=_finite(arow.get('modelClose',arow.get('close')),None);b=_finite(brow.get('modelClose',brow.get('close')),None)
    return math.log(b/a) if a and b and a>0 and b>0 else None

def prepare_articles(sentiment,price_store,sector_map,index_rows=None):
    global _V12_INDEX_BY_DATE,_V12_INDEX_DATES
    _V12_INDEX_BY_DATE={str(r.get('date'))[:10]:r for r in (index_rows or []) if r.get('date')};_V12_INDEX_DATES=sorted(_V12_INDEX_BY_DATE)
    articles,outcomes=_prepare_articles_before_exact_benchmark(sentiment,price_store,sector_map,index_rows)
    by_id={x.get('id'):x for rows in articles.values() for x in rows if x.get('id') is not None};corrected=missing=0;suspension_aligned=0
    for o in outcomes:
        rec=by_id.get(o.get('id'));rows=price_store.get(o.get('symbol')) or [];i=rec.get('availableIndex') if rec else None
        if not isinstance(i,int):continue
        origin=str(rec.get('availableDate'))[:10];j=bisect.bisect_left(_V12_INDEX_DATES,origin) if _V12_INDEX_DATES else -1
        for h in HORIZONS:
            if i+h>=len(rows):continue
            target=str(rows[i+h].get('date'))[:10];rr=o.get(f'r{h}');br=_benchmark_exact_date(index_rows,origin,target);ok=isinstance(br,(int,float)) and math.isfinite(float(br))
            o[f'matureDate{h}']=target;o[f'benchmarkTargetDate{h}']=target;o[f'benchmarkR{h}']=float(br) if ok else None;o[f'benchmarkAvailable{h}']=bool(ok);o[f'ar{h}']=float(rr)-float(br) if ok and isinstance(rr,(int,float)) and math.isfinite(float(rr)) else None
            corrected+=int(ok);missing+=int(not ok)
            if j>=0 and j<len(_V12_INDEX_DATES) and _V12_INDEX_DATES[j]==origin and j+h<len(_V12_INDEX_DATES) and _V12_INDEX_DATES[j+h]!=target:suspension_aligned+=1
    ENTITY_AUDIT['benchmarkAlignment']={'method':'VNINDEX_ORIGIN_TO_EXACT_STOCK_MATURITY_DATE','correctedOutcomes':corrected,'missingBenchmarkOutcomes':missing,'stockMaturityDifferentFromOrdinalIndexH':suspension_aligned,'missingPolicy':'ABSTAIN_NOT_RAW_RETURN'}
    print(json.dumps({'v12ExactEventBenchmark':ENTITY_AUDIT['benchmarkAlignment']},ensure_ascii=False),flush=True);return articles,outcomes

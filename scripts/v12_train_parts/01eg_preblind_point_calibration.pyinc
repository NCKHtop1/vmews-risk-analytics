# Point-price calibration for a zero-inflated return distribution.
#
# The monotone conditional q50 is a valid scenario median, but for stocks with a material
# unchanged-price mass it can map a broad range of informative direct-return scores to exactly
# zero.  That creates a degenerate point forecast even when the underlying OOF score has real
# cross-sectional rank/magnitude information.  Do not repair that by inflating sealed outputs.
# Instead, choose the released point map entirely inside the maturity-purged pre-blind 85-90%
# block, while keeping q20/q80 as the calibrated uncertainty interval.  The 90-100% block is
# never supplied here and remains an independent acceptance test.
_point_base_quantile_calibrate=_preblind_shrink_base_calibrate
_point_base_apply=_preblind_shrink_base_apply

def _point_candidate_metrics(y,p):
    yy=np.asarray(y,float);pp=np.asarray(p,float);good=np.isfinite(yy)&np.isfinite(pp);yy=yy[good];pp=pp[good]
    if not len(yy):return {'n':0,'mae':float('inf'),'maeSE':float('inf'),'baselineMAE':float('inf'),'maeEdge':-float('inf'),'forecastStd':0.0,'realizedStd':0.0,'dispersionRatio':0.0,'nonTrivialShare':0.0}
    loss=np.abs(yy-pp);mae=float(np.mean(loss));se=float(np.std(loss,ddof=1)/math.sqrt(len(loss))) if len(loss)>1 else 0.0;base=float(np.mean(np.abs(yy)));fs=float(np.std(pp));rs=float(np.std(yy))
    return {'n':int(len(yy)),'mae':mae,'maeSE':se,'baselineMAE':base,'maeEdge':base-mae,'forecastStd':fs,'realizedStd':rs,'dispersionRatio':fs/(rs or 1e-12),'nonTrivialShare':float(np.mean(np.abs(pp)>=.001))}

def calibrate(cal_y,cal_score,conform_y,conform_score):
    # Fit only the scenario-quantile/isotonic layer on 80-85%.  Its conformal adjustment is
    # intentionally ignored and recomputed below on a disjoint final pre-blind slice.
    layer,iso,_=_point_base_quantile_calibrate(cal_y,cal_score,conform_y,conform_score)
    cy=np.asarray(conform_y,float);cs=np.asarray(conform_score,float);n=len(cy)
    if n<300:
        # Conservative fallback: preserve the identity-regularized q50 route.  No blind data.
        lo0,med0,hi0=layer.predict(cs);g,fit_n,audit=_select_return_shrink(cy,med0)
        layer.returnShrink=float(g);layer.shrinkSelectionN=int(fit_n);layer.shrinkSelectionAudit=audit
        layer.pointMode='Q50';layer.pointScoreScale=1.0;layer.pointSelectionAudit={'method':'INSUFFICIENT_PREBLIND_ROWS_Q50','n':int(n),'sealedLabelsUsed':0}
        lo=lo0*g;hi=hi0*g;nonconf=np.maximum.reduce([lo-cy,cy-hi,np.zeros(len(cy))]) if n else np.asarray([],float)
    else:
        # Three disjoint slices inside 85-90%:
        # A) estimate positive scales, B) select the point family, C) conformal widening.
        a=max(1,n//3);b=max(a+1,2*n//3)
        lo0,med0,hi0=layer.predict(cs)
        q50_scale,q_n,q_audit=_select_return_shrink(cy[:a],med0[:a])
        score_scale,s_n,s_audit=_select_return_shrink(cy[:a],cs[:a])

        # Candidate B predictions are exactly what production would emit before conformal
        # widening: q50, or the scaled direct score clipped to the calibrated scenario envelope.
        q_lo=lo0[a:b]*q50_scale;q_hi=hi0[a:b]*q50_scale
        q_point=med0[a:b]*q50_scale
        direct=np.clip(cs[a:b]*score_scale,np.minimum(q_lo,q_hi),np.maximum(q_lo,q_hi))
        qm=_point_candidate_metrics(cy[a:b],q_point);dm=_point_candidate_metrics(cy[a:b],direct)
        best=min((('Q50',qm),('DIRECT_SCORE',dm)),key=lambda z:(z[1]['mae'], -z[1]['nonTrivialShare']))
        limit=float(best[1]['mae']+best[1]['maeSE'])
        eligible=[(name,m) for name,m in (('Q50',qm),('DIRECT_SCORE',dm)) if m['mae']<=limit+1e-15 and m['maeEdge']>0]
        # If pre-blind MAE cannot distinguish the candidates, prefer the non-degenerate map.
        # This is a model-risk tie-breaker only: the selected candidate must still beat the
        # no-change baseline here, and the untouched sealed magnitude/daily-bootstrap gate later.
        chosen=max(eligible,key=lambda z:(z[1]['nonTrivialShare'],z[1]['dispersionRatio'],-z[1]['mae'])) if eligible else best
        mode=chosen[0]
        layer.returnShrink=float(q50_scale);layer.shrinkSelectionN=int(q_n);layer.shrinkSelectionAudit=q_audit
        layer.pointMode=mode;layer.pointScoreScale=float(score_scale)
        layer.pointSelectionAudit={
          'method':'THREE_WAY_PREBLIND_POINT_FAMILY_SELECTION','selectionFitRows':int(a),'selectionValidationRows':int(b-a),'conformalRows':int(n-b),
          'selectionRule':'minimum validation MAE; within one-SE and positive no-change edge, prefer higher non-trivial share/dispersion',
          'bestMAEFamily':best[0],'oneSELimit':limit,'selectedFamily':mode,'q50':qm,'directScore':dm,
          'q50ScaleAudit':q_audit,'directScoreScaleAudit':s_audit,'sealedLabelsUsed':0,
          'reason':'conditional q50 can be exactly zero over a broad score region in a zero-inflated return distribution; point-family selection is pre-blind and sealed gates remain unchanged'
        }
        lo=lo0[b:]*q50_scale;hi=hi0[b:]*q50_scale;yy=cy[b:]
        nonconf=np.maximum.reduce([lo-yy,yy-hi,np.zeros(len(yy))]) if len(yy) else np.asarray([],float)

    target=.60;qlevel=min(1.0,math.ceil((len(nonconf)+1)*target)/max(1,len(nonconf)))
    qadj=float(np.quantile(nonconf,qlevel,method='higher')) if len(nonconf) else 0.0
    layer.conformalTarget=target;layer.conformalN=int(len(nonconf));layer.calibrationSplitPolicy='80-85% monotone quantile/isotonic; 85-90% split into scale-fit, point-family validation and conformal widening; all point selection is pre-blind; 90-100% remains sealed.'
    return layer,iso,max(0.0,qadj)

def apply_calibration(score,scen,iso,qadj):
    if isinstance(scen,_QuantileLayer) and hasattr(scen,'pointMode'):
        ss=np.asarray(score,float);p=np.asarray(iso.predict(ss),float);lo0,q50,hi0=scen.predict(ss);g=float(getattr(scen,'returnShrink',1.0));lo=lo0*g;hi=hi0*g
        if getattr(scen,'pointMode','Q50')=='DIRECT_SCORE':
            point=np.clip(ss*float(getattr(scen,'pointScoreScale',1.0)),np.minimum(lo,hi),np.maximum(lo,hi))
        else:point=q50*g
        lo=lo-float(qadj);hi=hi+float(qadj);ns=np.full(len(point),int(scen.n),dtype=int)
        return p,np.asarray(point,float),np.asarray(lo,float),np.asarray(hi,float),ns
    return _point_base_apply(score,scen,iso,qadj)

_fit_horizon_before_sector_ablation=fit_horizon

def _sector_ablation(X,y,D,dates,h,idx_by_expert,z):
    if 'REGIME' not in (z.get('active') or []):return {'status':'NOT_APPLICABLE','reason':'REGIME expert inactive'}
    sector_idx={FEATURES.index(k) for k in SECTOR_FEATURES if k in FEATURES};regime_full=list(idx_by_expert['REGIME']);regime_no=np.asarray([i for i in regime_full if int(i) not in sector_idx],int)
    if len(regime_no)==len(regime_full) or len(regime_no)<5:return {'status':'FAIL','reason':'sector feature indexes not isolated','fullFeatures':len(regime_full),'withoutSectorFeatures':len(regime_no)}
    kind=(z.get('choice') or {}).get('REGIME',{}).get('kind','RIDGE');pred=np.full(len(y),np.nan)
    for fold in OOF_FOLDS:
        ii,pp,_=fit_predict(X,y,D,dates,regime_no,fold,h,kind);pred[ii]=pp
    Maturity=label_maturity_array(h);d80=dates[int(.80*len(dates))];pred[Maturity>=d80]=np.nan
    cap=OOF_CAPTURE.get(int(h)) or {};base_pred={k:np.array(v,copy=True) for k,v in (cap.get('predictions') or {}).items()};base_pred['REGIME']=pred;active=list(z.get('active') or []);good=np.isfinite(y)&(Maturity<d80)
    for name in active:good&=np.isfinite(base_pred[name])
    if good.sum()<1000:return {'status':'INSUFFICIENT','reason':'sector ablation OOF too sparse','oofRows':int(good.sum())}
    meta,_=fit_meta(base_pred,active,good,y)
    models=fit_experts_at_cut(X,y,D,dates,h,idx_by_expert,{k:v['kind'] for k,v in (z.get('choice') or {}).items()},.80)
    tr=np.isfinite(y)&(Maturity<d80);xx=X[:,regime_no];pprep=prep(xx,tr);zz=apply_prep(xx,pprep);rm=make_model(kind);rm.fit(zz[tr],y[tr]);models['REGIME']=(rm,pprep,regime_no)
    masks=interval_masks(D,dates);ia=np.where(masks['calA']&np.isfinite(y))[0];ib=np.where(masks['calB']&np.isfinite(y))[0];it=np.where(masks['audit']&np.isfinite(y))[0]
    def score(idx):
        ep=predict_experts(models,X,idx);return meta.predict(combine_pred(ep,active))
    sa,sb,st=score(ia),score(ib),score(it);layer,iso,qadj=calibrate(y[ia],sa,y[ib],sb);p,med,lo,hi,_=apply_calibration(st,layer,iso,qadj);without=audit_metrics(y[it],st,p,med,lo,hi,D[it]);full=z.get('sealedAudit') or {}
    return {'status':'PASS','method':'Sealed audit only. Same active expert stack and pre-sealed chronology, but REGIME is refit after removing all sector PIT features. This diagnostic never selects or promotes the production model.','horizon':int(h),'regimeModelKind':kind,'sectorFeatures':list(SECTOR_FEATURES),'regimeFeatureCountFull':len(regime_full),'regimeFeatureCountWithoutSector':len(regime_no),'oofRows':int(good.sum()),'withoutSector':without,'fullModel':{k:full.get(k) for k in ['n','rankIC','spread','scenarioMAEImprove','scenarioRankIC','coverage20_80']},'deltaRankIC':float(full.get('rankIC',0)-without.get('rankIC',0)),'deltaSpread':float(full.get('spread',0)-without.get('spread',0)),'deltaScenarioMAEImprove':float(full.get('scenarioMAEImprove',0)-without.get('scenarioMAEImprove',0))}

def fit_horizon(X,y,D,dates,h,idx_by_expert):
    z=_fit_horizon_before_sector_ablation(X,y,D,dates,h,idx_by_expert);sector=_sector_ablation(X,y,D,dates,h,idx_by_expert,z);z['sectorAblation']=sector;z.setdefault('ablation',{})['SECTOR_FEATURES']=sector;return z

import itertools as _pbo_itertools
from scipy.stats import spearmanr as _pbo_spearman

_strict_fit_horizon_before_pbo=fit_horizon

def _pbo_metric(expert_pred,y,D,active):
    base=[('NUMERICAL',),('REGIME',),('NUMERICAL','REGIME')]
    for name in ['EVENT','FLOW','FUNDAMENTAL_EVENT','RUMOR']:
        if name in expert_pred:base.append(('NUMERICAL','REGIME',name))
    at=tuple(active)
    if at not in base:base.append(at)
    candidates=[]
    for c in base:
        if c not in candidates:candidates.append(c)
    common=np.isfinite(y)
    for name in set(n for c in candidates for n in c):common&=np.isfinite(expert_pred[name])
    idx=np.where(common)[0];odates=np.asarray(sorted(set(D[idx])))
    if len(odates)<40 or len(idx)<2000:return {'status':'INSUFFICIENT','pbo':1.0,'splits':0,'candidates':[list(x) for x in candidates],'medianRankCorrelation':None}
    blocks=np.array_split(odates,8);block_of={d:i for i,b in enumerate(blocks) for d in b};rows_by_block=[np.asarray([k for k in idx if block_of.get(D[k])==b],int) for b in range(8)]
    oos_percentiles=[];rank_corr=[];details=[]
    combos=list(_pbo_itertools.combinations(range(8),4))
    # A combination and its complement are mirror images; keep all 70 CSCV splits for transparency.
    for tr_blocks in combos:
        tr=np.concatenate([rows_by_block[b] for b in tr_blocks]);te=np.concatenate([rows_by_block[b] for b in range(8) if b not in tr_blocks])
        if len(tr)<500 or len(te)<500:continue
        ins=[];outs=[]
        for c in candidates:
            M=np.column_stack([expert_pred[n] for n in c]);m=Ridge(alpha=20.0);m.fit(M[tr],y[tr]);pi=m.predict(M[tr]);po=m.predict(M[te]);ins.append(rank_stats(y[tr],pi,D[tr])['ic']);outs.append(rank_stats(y[te],po,D[te])['ic'])
        best=int(np.argmax(ins));order=np.argsort(np.asarray(outs));rank=int(np.where(order==best)[0][0]);pct=(rank+.5)/len(candidates);oos_percentiles.append(float(pct));rc=_pbo_spearman(ins,outs).statistic if len(candidates)>=3 else None
        if rc is not None and finite(rc):rank_corr.append(float(rc))
        if len(details)<12:details.append({'trainBlocks':list(tr_blocks),'selected':list(candidates[best]),'selectedIS':float(ins[best]),'selectedOOS':float(outs[best]),'oosPercentile':float(pct)})
    pbo=float(np.mean(np.asarray(oos_percentiles)<.5)) if oos_percentiles else 1.0;med=float(np.median(rank_corr)) if rank_corr else None
    return {'status':'PASS' if oos_percentiles else 'INSUFFICIENT','method':'CSCV 8 blocks / 4 train blocks; probability the in-sample winner ranks below OOS median','pbo':pbo,'splits':len(oos_percentiles),'candidateCount':len(candidates),'candidates':[list(x) for x in candidates],'medianRankCorrelation':med,'oosWinnerPercentileMedian':float(np.median(oos_percentiles)) if oos_percentiles else None,'sampleSplits':details}

def fit_horizon(X,y,D,dates,h,idx_by_expert):
    z=_strict_fit_horizon_before_pbo(X,y,D,dates,h,idx_by_expert);capture=OOF_CAPTURE.get(int(h)) or {};pbo=_pbo_metric(capture.get('predictions') or {},y,D,z.get('active') or ['NUMERICAL','REGIME']) if capture.get('predictions') else {'status':'INSUFFICIENT','pbo':1.0,'splits':0,'medianRankCorrelation':None}
    generalization=bool(pbo.get('status')=='PASS' and pbo.get('splits',0)>=30 and pbo.get('pbo',1.0)<=.50 and (pbo.get('medianRankCorrelation') is None or pbo.get('medianRankCorrelation')>=0.0))
    z['pboAudit']=pbo;z.setdefault('gates',{})['generalization']=generalization
    return z

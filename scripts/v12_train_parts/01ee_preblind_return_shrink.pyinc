_preblind_shrink_base_calibrate=calibrate
_preblind_shrink_base_apply=apply_calibration

def _select_return_shrink(y,med):
    yy=np.asarray(y,float);mm=np.asarray(med,float);good=np.isfinite(yy)&np.isfinite(mm)
    yy=yy[good];mm=mm[good]
    if len(yy)<100:return 1.0,0,None
    # Regularized one-dimensional calibration only on the pre-blind conformal block.
    # The production/blind 90-100% labels are never supplied to this function.
    # Keep a strictly-positive floor (no degenerate no-change g=0 candidate), but allow
    # stronger shrinkage when the pre-blind data support it. To avoid chasing tiny pooled-MAE
    # differences that do not generalize, use the standard one-SE model-selection rule:
    # among candidates statistically indistinguishable from the empirical optimum, choose the
    # smaller positive multiplier (the more conservative return magnitude). This is determined
    # entirely from pre-blind row losses and cannot inspect the sealed audit block.
    grid_min=.05;grid=np.linspace(grid_min,1.0,39)
    rows=[]
    for g in grid:
        losses=np.abs(yy-float(g)*mm)
        mae=float(np.mean(losses))
        se=float(np.std(losses,ddof=1)/math.sqrt(len(losses))) if len(losses)>1 else 0.0
        rows.append((float(g),mae,se))
    best_g,best_mae,best_se=min(rows,key=lambda z:(z[1],abs(z[0]-1.0),z[0]))
    one_se_limit=float(best_mae+best_se)
    eligible=[z for z in rows if z[1]<=one_se_limit+1e-15]
    selected_g,selected_mae,selected_se=min(eligible,key=lambda z:z[0])
    base=float(np.mean(np.abs(yy-mm)));eps=1e-12
    return float(selected_g),len(yy),{'baseMAE':base,'selectedMAE':float(selected_mae),'empiricalBestMAE':float(best_mae),'empiricalBestShrink':float(best_g),'empiricalBestSE':float(best_se),'oneSELimit':one_se_limit,'oneSEEligibleN':len(eligible),'selectionRule':'ONE_STANDARD_ERROR_TOWARD_STRONGER_POSITIVE_SHRINK','gridMin':grid_min,'gridMax':1.0,'gridN':len(grid),'selectedAtLowerBound':bool(abs(float(selected_g)-grid_min)<=eps),'selectedAtUpperBound':bool(abs(float(selected_g)-1.0)<=eps)}

def calibrate(cal_y,cal_score,conform_y,conform_score):
    layer,iso,_=_preblind_shrink_base_calibrate(cal_y,cal_score,conform_y,conform_score)
    cy=np.asarray(conform_y,float);cs=np.asarray(conform_score,float);n=len(cy);mid=max(1,n//2)
    lo0,med0,hi0=layer.predict(cs)
    gamma,fit_n,audit=_select_return_shrink(cy[:mid],med0[:mid])
    layer.returnShrink=float(gamma);layer.shrinkSelectionN=int(fit_n);layer.shrinkSelectionAudit=audit
    # Recompute conformal widening on a disjoint second half after shrinkage.
    # This keeps both tuning layers strictly pre-blind while avoiding same-row reuse.
    yy=cy[mid:];lo=lo0[mid:]*gamma;hi=hi0[mid:]*gamma
    nonconf=np.maximum.reduce([lo-yy,yy-hi,np.zeros(len(yy))]) if len(yy) else np.asarray([],float)
    target=.60;qlevel=min(1.0,math.ceil((len(nonconf)+1)*target)/max(1,len(nonconf)))
    qadj=float(np.quantile(nonconf,qlevel,method='higher')) if len(nonconf) else 0.0
    layer.conformalTarget=target;layer.conformalN=int(len(nonconf));layer.calibrationSplitPolicy='80-85% quantile/isotonic; first half of maturity-purged 85-90% selects strictly-positive return shrink via a pre-blind one-standard-error rule; second half computes conformal widening; 90-100% remains sealed.'
    return layer,iso,max(0.0,qadj)

def apply_calibration(score,scen,iso,qadj):
    if isinstance(scen,_QuantileLayer) and hasattr(scen,'returnShrink'):
        p=np.asarray(iso.predict(score),float);lo,med,hi=scen.predict(score);g=float(scen.returnShrink)
        lo=lo*g-float(qadj);med=med*g;hi=hi*g+float(qadj);ns=np.full(len(med),int(scen.n),dtype=int)
        return p,med,lo,hi,ns
    return _preblind_shrink_base_apply(score,scen,iso,qadj)

from v12_universe import current_hose_symbols, discover_candidates
import v12_data_sources as _v12ds
HISTORICAL_ONLY=set();CURRENT_HOSE=set();UNIVERSE_AUDIT={};CURRENT_SHORT_ROUTE_AUDIT={}
_raw_build_price_store=build_price_store
_raw_base_panel=base_panel
_entity_source_audit_summary=source_audit_summary

def manifest_symbols():
    global CURRENT_HOSE
    CURRENT_HOSE=set(current_hose_symbols());candidates,discovery=discover_candidates();candidate_symbols=sorted(candidates)
    UNIVERSE_AUDIT.clear();UNIVERSE_AUDIT.update({'version':'VMEWS-UNIVERSE-AUDIT-12.2.0','policy':'Current HOSE plus only delisted STOCK rows whose retained VCI product_grp_id explicitly maps to former HSX/STO. Historical-only members require >=520 real observations and a stale terminal date; they enter training/backtest only and never current forecasts. Current-route availability is audited separately from >=520-row training eligibility so genuine recent listings are not mislabeled as provider outages.','currentHOSE':len(CURRENT_HOSE),'discovery':discovery,'candidateMetadata':{s:candidates[s] for s in candidate_symbols},'candidateCount':len(candidate_symbols)})
    return sorted(CURRENT_HOSE|set(candidate_symbols))

def _probe_current_short_route(symbol,modal_cut):
    """Probe only current symbols that failed the >=520-row training contract.
    Real, fresh short histories can certify route availability but can never enter training.
    Provider quota layers may raise SystemExit; treat that as a failed route rather than
    terminating the immutable training run, while still allowing KeyboardInterrupt through.
    """
    fresh_cut=(datetime.fromisoformat(modal_cut).date()-__import__('datetime').timedelta(days=20)).isoformat()
    attempts=[]
    try:
        from vnstock.ui import Market
        today=datetime.now(_v12ds.VN_TZ).date();start=(today-__import__('datetime').timedelta(days=1100)).isoformat()
        _v12ds._throttle_vnstock();df=Market().equity(symbol).ohlcv(start=start,end=today.isoformat(),count=800);rows,scale=_v12ds._normalize_df(df,symbol,'Vnstock Unified Market current-route probe')
        attempts.append({'stage':'VNSTOCK_CURRENT_ROUTE_PROBE','rows':len(rows),'scale':scale,'end':rows[-1]['date'] if rows else None})
        if len(rows)>=60 and rows[-1]['date']>=fresh_cut:
            return {'symbol':symbol,'route':'VNSTOCK_CURRENT_SHORT_HISTORY','rows':len(rows),'start':rows[0]['date'],'end':rows[-1]['date'],'routeAvailable':True,'trainingEligible':False,'minimumTrainingRows':_v12ds.MIN_ROWS,'attempts':attempts,'policy':'Real fresh OHLCV route is available, but <520 rows remain excluded from model training.'}
    except (Exception,SystemExit) as e:attempts.append({'stage':'VNSTOCK_CURRENT_ROUTE_PROBE','error':f'{type(e).__name__}: {e}'[:300]})
    try:
        rows,meta=_v12ds.yahoo_history(symbol);attempts.append({'stage':'YAHOO_CURRENT_ROUTE_PROBE','rows':len(rows),'end':rows[-1]['date'] if rows else None,'meta':meta})
        if len(rows)>=60 and rows[-1]['date']>=fresh_cut:
            return {'symbol':symbol,'route':'YAHOO_CURRENT_SHORT_HISTORY','rows':len(rows),'start':rows[0]['date'],'end':rows[-1]['date'],'routeAvailable':True,'trainingEligible':False,'minimumTrainingRows':_v12ds.MIN_ROWS,'attempts':attempts,'policy':'Real fresh adjusted OHLCV route is available, but <520 rows remain excluded from model training.'}
    except (Exception,SystemExit) as e:attempts.append({'stage':'YAHOO_CURRENT_ROUTE_PROBE','error':f'{type(e).__name__}: {e}'[:300]})
    try:
        rows,meta=_v12ds.cached_history(symbol);attempts.append({'stage':'CACHE_CURRENT_ROUTE_PROBE','rows':len(rows),'end':rows[-1]['date'] if rows else None,'meta':meta})
        if len(rows)>=60 and rows[-1]['date']>=fresh_cut:
            return {'symbol':symbol,'route':'CACHE_CURRENT_SHORT_HISTORY','rows':len(rows),'start':rows[0]['date'],'end':rows[-1]['date'],'routeAvailable':True,'trainingEligible':False,'minimumTrainingRows':_v12ds.MIN_ROWS,'attempts':attempts,'policy':'Real fresh cached OHLCV route is available, but <520 rows remain excluded from model training.'}
    except (Exception,SystemExit) as e:attempts.append({'stage':'CACHE_CURRENT_ROUTE_PROBE','error':f'{type(e).__name__}: {e}'[:300]})
    return {'symbol':symbol,'routeAvailable':False,'trainingEligible':False,'attempts':attempts}

def build_price_store(symbols):
    store,audits,failures=_raw_build_price_store(symbols);historical_fetch_failures={s:failures.pop(s) for s in list(failures) if s not in CURRENT_HOSE};current_ends=[rows[-1]['date'] for s,rows in store.items() if s in CURRENT_HOSE and rows];modal_cut=max(set(current_ends),key=current_ends.count) if current_ends else max(current_ends,default='9999-12-31');cutoff=(datetime.fromisoformat(modal_cut).date()-__import__('datetime').timedelta(days=20)).isoformat() if modal_cut!='9999-12-31' else modal_cut;historical={};rejected={}
    for s in list(store):
        if s in CURRENT_HOSE:continue
        rows=store[s];meta=(UNIVERSE_AUDIT.get('candidateMetadata') or {}).get(s,{})
        if len(rows)>=520 and rows[-1]['date']<cutoff and meta.get('formerProductGroup')=='STO' and meta.get('formerExchange')=='HOSE':historical[s]={'rows':len(rows),'start':rows[0]['date'],'end':rows[-1]['date'],'metadata':meta,'priceRoute':audits.get(s,{}).get('route')}
        else:rejected[s]={'rows':len(rows),'end':rows[-1]['date'] if rows else None,'metadata':meta};store.pop(s,None);audits.pop(s,None)
    HISTORICAL_ONLY.clear();HISTORICAL_ONLY.update(historical)
    training_passed=sum(s in audits for s in CURRENT_HOSE);training_ineligible={s:failures.get(s) for s in CURRENT_HOSE if s in failures}
    CURRENT_SHORT_ROUTE_AUDIT.clear()
    for s in sorted(training_ineligible):
        probe=_probe_current_short_route(s,modal_cut)
        if probe.get('routeAvailable'):CURRENT_SHORT_ROUTE_AUDIT[s]=probe
    route_available=training_passed+len(CURRENT_SHORT_ROUTE_AUDIT);route_unavailable={s:training_ineligible.get(s) for s in CURRENT_HOSE if s not in audits and s not in CURRENT_SHORT_ROUTE_AUDIT}
    UNIVERSE_AUDIT.update({'currentMarketCutoff':modal_cut,'historicalStaleBefore':cutoff,'currentPassed':training_passed,'currentTrainingEligible':training_passed,'currentTrainingIneligible':len(training_ineligible),'currentRoutePassed':route_available,'currentRouteFailed':len(route_unavailable),'currentCoverage':route_available/max(1,len(CURRENT_HOSE)),'currentShortHistoryRoutePassed':len(CURRENT_SHORT_ROUTE_AUDIT),'currentShortHistoryRoutes':dict(CURRENT_SHORT_ROUTE_AUDIT),'currentRouteFailures':route_unavailable,'currentFailures':training_ineligible,'historicalOnlyCount':len(historical),'historicalOnly':historical,'rejectedCandidateCount':len(rejected),'rejectedCandidates':rejected,'historicalFetchFailures':historical_fetch_failures})
    print(json.dumps({'v12Universe':{'currentReference':len(CURRENT_HOSE),'currentTrainingEligible':training_passed,'currentRoutePassed':route_available,'currentRouteCoverage':UNIVERSE_AUDIT['currentCoverage'],'currentShortHistoryRoutePassed':len(CURRENT_SHORT_ROUTE_AUDIT),'historicalOnly':len(HISTORICAL_ONLY),'staleBefore':cutoff,'symbols':sorted(HISTORICAL_ONLY)}},ensure_ascii=False),flush=True);return store,audits,failures

def base_panel(price_store):
    panel,latest,rows_by_symbol=_raw_base_panel(price_store)
    for s in list(latest):
        if s in HISTORICAL_ONLY:latest.pop(s,None)
    return panel,latest,rows_by_symbol

def source_audit_summary(audits,failures):
    out=_entity_source_audit_summary(audits,failures);out['universeAudit']=dict(UNIVERSE_AUDIT);out['currentSymbolsPassed']=UNIVERSE_AUDIT.get('currentTrainingEligible');out['currentSymbolsFailed']=UNIVERSE_AUDIT.get('currentTrainingIneligible');out['currentRouteSymbolsAvailable']=UNIVERSE_AUDIT.get('currentRoutePassed');out['currentRouteSymbolsUnavailable']=UNIVERSE_AUDIT.get('currentRouteFailed');out['currentRouteCoverageRatio']=UNIVERSE_AUDIT.get('currentCoverage');out['currentShortHistoryRouteAudits']=dict(CURRENT_SHORT_ROUTE_AUDIT);out['historicalOnlySymbols']=sorted(HISTORICAL_ONLY);return out

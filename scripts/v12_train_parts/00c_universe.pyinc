from v12_universe import current_hose_symbols, discover_candidates
HISTORICAL_ONLY=set();CURRENT_HOSE=set();UNIVERSE_AUDIT={}
_raw_build_price_store=build_price_store
_raw_base_panel=base_panel
_entity_source_audit_summary=source_audit_summary

def manifest_symbols():
    global CURRENT_HOSE
    CURRENT_HOSE=set(current_hose_symbols());candidates,discovery=discover_candidates();candidate_symbols=sorted(candidates)
    UNIVERSE_AUDIT.clear();UNIVERSE_AUDIT.update({'version':'VMEWS-UNIVERSE-AUDIT-12.1.0','policy':'Current HOSE plus only delisted STOCK rows whose retained VCI product_grp_id explicitly maps to former HSX/STO. Historical-only members require >=520 real observations and a stale terminal date; they enter training/backtest only and never current forecasts.','currentHOSE':len(CURRENT_HOSE),'discovery':discovery,'candidateMetadata':{s:candidates[s] for s in candidate_symbols},'candidateCount':len(candidate_symbols)})
    return sorted(CURRENT_HOSE|set(candidate_symbols))

def build_price_store(symbols):
    store,audits,failures=_raw_build_price_store(symbols);historical_fetch_failures={s:failures.pop(s) for s in list(failures) if s not in CURRENT_HOSE};current_ends=[rows[-1]['date'] for s,rows in store.items() if s in CURRENT_HOSE and rows];modal_cut=max(set(current_ends),key=current_ends.count) if current_ends else max(current_ends,default='9999-12-31');cutoff=(datetime.fromisoformat(modal_cut).date()-__import__('datetime').timedelta(days=20)).isoformat() if modal_cut!='9999-12-31' else modal_cut;historical={};rejected={}
    for s in list(store):
        if s in CURRENT_HOSE:continue
        rows=store[s];meta=(UNIVERSE_AUDIT.get('candidateMetadata') or {}).get(s,{})
        if len(rows)>=520 and rows[-1]['date']<cutoff and meta.get('formerProductGroup')=='STO' and meta.get('formerExchange')=='HOSE':historical[s]={'rows':len(rows),'start':rows[0]['date'],'end':rows[-1]['date'],'metadata':meta,'priceRoute':audits.get(s,{}).get('route')}
        else:rejected[s]={'rows':len(rows),'end':rows[-1]['date'] if rows else None,'metadata':meta};store.pop(s,None);audits.pop(s,None)
    HISTORICAL_ONLY.clear();HISTORICAL_ONLY.update(historical);current_passed=sum(s in audits for s in CURRENT_HOSE);current_failed={s:failures.get(s) for s in CURRENT_HOSE if s in failures};UNIVERSE_AUDIT.update({'currentMarketCutoff':modal_cut,'historicalStaleBefore':cutoff,'currentPassed':current_passed,'currentFailed':len(current_failed),'currentCoverage':current_passed/max(1,len(CURRENT_HOSE)),'currentFailures':current_failed,'historicalOnlyCount':len(historical),'historicalOnly':historical,'rejectedCandidateCount':len(rejected),'rejectedCandidates':rejected,'historicalFetchFailures':historical_fetch_failures})
    print(json.dumps({'v12Universe':{'currentReference':len(CURRENT_HOSE),'currentPassed':current_passed,'currentCoverage':UNIVERSE_AUDIT['currentCoverage'],'historicalOnly':len(HISTORICAL_ONLY),'staleBefore':cutoff,'symbols':sorted(HISTORICAL_ONLY)}},ensure_ascii=False),flush=True);return store,audits,failures

def base_panel(price_store):
    panel,latest,rows_by_symbol=_raw_base_panel(price_store)
    for s in list(latest):
        if s in HISTORICAL_ONLY:latest.pop(s,None)
    return panel,latest,rows_by_symbol

def source_audit_summary(audits,failures):
    out=_entity_source_audit_summary(audits,failures);out['universeAudit']=dict(UNIVERSE_AUDIT);out['currentSymbolsPassed']=UNIVERSE_AUDIT.get('currentPassed');out['currentSymbolsFailed']=UNIVERSE_AUDIT.get('currentFailed');out['currentRouteCoverageRatio']=UNIVERSE_AUDIT.get('currentCoverage');out['historicalOnlySymbols']=sorted(HISTORICAL_ONLY);return out

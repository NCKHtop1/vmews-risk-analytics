# Gate-aligned chronological point selection. 90-100% remains sealed/evaluation-only.
# Parameters: maturity-purged 80-85%; family selection: whole dates in early 85-90%;
# conformal widening: late 85-90%. No-change, not Q50, is the scientific point baseline.
_gate_before_calibrate=calibrate
_gate_before_apply=apply_calibration

def _gate_h():return max(1,min(5,int(globals().get('V12_ACTIVE_HORIZON',1))))
def _gate_floor(h):return ({1:.05,2:.07,3:.08,4:.09,5:.10}[int(h)],{1:.04,2:.05,3:.06,4:.07,5:.08}[int(h)])
def _gate_p90(y,p):
    y=np.asarray(y,float);p=np.asarray(p,float);g=np.isfinite(y)&np.isfinite(p);y=y[g];p=p[g]
    return float(np.quantile(np.abs(p),.9)/max(float(np.quantile(np.abs(y),.9)),1e-12)) if len(y)>1 else 0.0

def _gate_origin_one_se(score,y,h):
    """Zero-intercept L1 scale; one-SE rule prevents a statistically needless collapse to ~0."""
    s=np.asarray(score,float);y=np.asarray(y,float);g=np.isfinite(s)&np.isfinite(y);s=s[g];y=y[g]
    if len(s)<240 or float(np.std(s))<1e-10:return None
    sm=float(np.median(s));ym=float(np.median(y));smad=float(np.median(np.abs(s-sm))*1.4826);ymad=float(np.median(np.abs(y-ym))*1.4826);ratio=float(ymad/max(smad,1e-8));upper=float(min(30.,max(2.,2.5*ratio)));a=np.linspace(.05,min(2.,upper),40);b=np.geomspace(max(.1,min(2.,upper)),upper,44) if upper>2 else np.asarray([],float);grid=np.unique(np.r_[a,b,1.]);rows=[]
    for q in grid:
        p=float(q)*s;loss=np.abs(y-p);rows.append((float(q),float(np.mean(loss)),float(np.std(loss,ddof=1)/math.sqrt(len(loss))) if len(loss)>1 else 0.))
    best=min(rows,key=lambda z:(z[1],abs(z[0]-1.)));fd,fp=_gate_floor(h);target=max(fd*float(np.std(y))/max(float(np.std(s)),1e-10),fp*float(np.quantile(np.abs(y),.9))/max(float(np.quantile(np.abs(s),.9)),1e-10));target=float(np.clip(target,grid.min(),grid.max()));ok=[z for z in rows if z[1]<=best[1]+max(best[2],1e-12)];pick=min(ok,key=lambda z:(abs(z[0]-target),z[1]));return {'intercept':0.,'slope':pick[0],'fitRows':int(len(y)),'fitMAE':pick[1],'bestMAE':best[1],'bestMAESE':best[2],'oneSEAdmissibleN':len(ok),'magnitudeTargetSlope':target,'scoreStd':float(np.std(s)),'realizedStd':float(np.std(y)),'robustScaleRatio':ratio,'slopeGridMin':float(grid.min()),'slopeGridMax':float(grid.max()),'slopeGridN':len(grid),'objective':'PREBLIND_L1_ONE_SE_ZERO_INTERCEPT','horizon':int(h),'sealedLabelsUsed':0}

def _gate_rank_one_se(y,r,h):
    y=np.asarray(y,float);r=np.asarray(r,float);g=np.isfinite(y)&np.isfinite(r);y=y[g];r=r[g]
    if len(y)<240 or float(np.std(r))<1e-10:return None
    ratio=float(np.std(y)/max(np.std(r),1e-10));upper=float(min(.20,max(.003,3.*ratio)));a=np.linspace(0.,min(.03,upper),81);b=np.geomspace(max(.001,min(.03,upper)),upper,48) if upper>.03 else np.asarray([],float);grid=np.unique(np.r_[a,b,0.]);rows=[]
    for q in grid:
        p=float(q)*r;loss=np.abs(y-p);rows.append((float(q),float(np.mean(loss)),float(np.std(loss,ddof=1)/math.sqrt(len(loss))) if len(loss)>1 else 0.))
    best=min(rows,key=lambda z:(z[1],z[0]));fd,fp=_gate_floor(h);target=max(fd*float(np.std(y))/max(float(np.std(r)),1e-10),fp*float(np.quantile(np.abs(y),.9))/max(float(np.quantile(np.abs(r),.9)),1e-10));target=float(np.clip(target,grid.min(),grid.max()));ok=[z for z in rows if z[1]<=best[1]+max(best[2],1e-12)];pick=min(ok,key=lambda z:(abs(z[0]-target),z[1]));return {'kind':'ZERO_PLUS_RANK','residualScale':pick[0],'fitRows':int(len(y)),'fitMAE':pick[1],'bestMAE':best[1],'bestMAESE':best[2],'oneSEAdmissibleN':len(ok),'magnitudeTargetScale':target,'gridMin':float(grid.min()),'gridMax':float(grid.max()),'gridN':len(grid),'objective':'PREBLIND_L1_ONE_SE_ZERO_CENTERED_WITHIN_DATE_RANK','horizon':int(h),'sealedLabelsUsed':0}

def _gate_rec(name,y,p,d,h,model=None):
    y=np.asarray(y,float);p=np.asarray(p,float);d=np.asarray(d,dtype=object);m=_point_candidate_metrics(y,p);m['p90MagnitudeRatio']=_gate_p90(y,p);fd,fp=_gate_floor(h);pair=_paired_challenger_audit(y,np.zeros(len(y)),p);stab=_xsec_date_block_stability(y,np.zeros(len(y)),p,d,4);pos=bool(m.get('maeEdge',-99)>0);mag=bool(m.get('dispersionRatio',0)>=fd and m['p90MagnitudeRatio']>=fp);stable=bool(stab.get('stable') is True);adm=bool(pos and mag and stable);return {'name':name,'pred':p,'metrics':m,'pairedVsNoChange':pair,'dateStabilityVsNoChange':stab,'model':model,'preblindPositiveMAEEdge':pos,'preblindMagnitudeAdmissible':mag,'preblindTemporalStable':stable,'preblindAdmissible':adm,'preblindStrongEvidence':bool(adm and pair.get('pass') is True),'minimumDispersionRatio':fd,'minimumP90MagnitudeRatio':fp}

def calibrate(cal_y,cal_score,conform_y,conform_score,cal_dates=None,conform_dates=None):
    if cal_dates is None or conform_dates is None:return _gate_before_calibrate(cal_y,cal_score,conform_y,conform_score)
    layer,iso,_=_point_base_quantile_calibrate(cal_y,cal_score,conform_y,conform_score)
    if not isinstance(layer,_QuantileLayer):return layer,iso,0.
    fy=np.asarray(cal_y,float);fs=np.asarray(cal_score,float);fd=np.asarray(cal_dates,dtype=object);cy=np.asarray(conform_y,float);cs=np.asarray(conform_score,float);cd=np.asarray(conform_dates,dtype=object)
    if len(fy)!=len(fs) or len(fy)!=len(fd) or len(cy)!=len(cs) or len(cy)!=len(cd):raise RuntimeError('gate-aligned chronology alignment mismatch')
    sp=_chrono_date_split(fd,cd)
    if sp is None or len(fy)<300 or len(cy)<300:raise RuntimeError('gate-aligned chronology requires >=300 fit/conform rows and >=4 distinct conform dates')
    h=_gate_h();iv=sp['validationIndex'];ic=sp['conformalIndex'];loF,qF,hiF=layer.predict(fs);loV,qV,hiV=layer.predict(cs[iv]);qs,qn,qa=_select_return_shrink(fy,qF);ss,sn,sa=_select_return_shrink(fy,fs);median=_fit_binned_monotone_median(fs,fy,15);aff=_fit_robust_affine_score(fs,fy);origin=_fit_robust_origin_scale(fs,fy);origin1=_gate_origin_one_se(fs,fy,h);layer.returnShrink=float(qs);layer.shrinkSelectionN=int(qn);layer.shrinkSelectionAudit=qa;layer.pointMode='Q50';layer.pointScoreScale=float(ss);layer.pointBinnedMedian=median;layer.pointAffineModel=None;layer.pointDeadband=0.;layer.pointXsecModel=None;loV=np.asarray(loV,float)*qs;hiV=np.asarray(hiV,float)*qs;qpoint=np.asarray(qV,float)*qs
    R=[_gate_rec('Q50',cy[iv],qpoint,cd[iv],h)];R.append(_gate_rec('DIRECT_SCORE',cy[iv],_clip_between(cs[iv]*ss,loV,hiV),cd[iv],h))
    if median is not None:R.append(_gate_rec('BINNED_MONOTONE_MEDIAN',cy[iv],_clip_between(_predict_binned_monotone(median,cs[iv]),loV,hiV),cd[iv],h,median))
    if aff is not None:R.append(_gate_rec('ROBUST_AFFINE_SCORE',cy[iv],_clip_between(_affine_predict(aff,cs[iv]),loV,hiV),cd[iv],h,aff))
    if origin is not None:R.append(_gate_rec('ROBUST_ORIGIN_SCALE',cy[iv],_clip_between(_affine_predict(origin,cs[iv]),loV,hiV),cd[iv],h,origin))
    if origin1 is not None:R.append(_gate_rec('ROBUST_ORIGIN_SCALE_1SE',cy[iv],_clip_between(_affine_predict(origin1,cs[iv]),loV,hiV),cd[iv],h,origin1))
    rf=_xsec_rank_signal(fs,fd);rv=_xsec_rank_signal(cs[iv],cd[iv]);basefit=_xsec_positive_scale(fy,np.asarray(qF,float)*qs,rf)
    if basefit is not None:
        model={'kind':'BASE_PLUS_RANK','residualScale':float(basefit['scale']),'fit':basefit};R.append(_gate_rec('XSEC_BASE_PLUS_RANK',cy[iv],_clip_between(qpoint+model['residualScale']*rv,loV,hiV),cd[iv],h,model))
    center=_isotonic_half_center(iso,fs) if '_isotonic_half_center' in globals() else float(np.median(fs));mf=_xsec_market_rank_fit(fy,fs,fd,center)
    if mf is not None:
        model={'kind':'MARKET_PLUS_RANK',**mf};R.append(_gate_rec('XSEC_MARKET_PLUS_RANK',cy[iv],_clip_between(_xsec_apply_model(model,cs[iv],cd[iv]),loV,hiV),cd[iv],h,model))
    zf=_xsec_positive_scale(fy,np.zeros(len(fy)),rf)
    if zf is not None:
        model={'kind':'ZERO_PLUS_RANK','residualScale':float(zf['scale']),'fit':zf};R.append(_gate_rec('XSEC_ZERO_PLUS_RANK',cy[iv],_clip_between(model['residualScale']*rv,loV,hiV),cd[iv],h,model))
    z1=_gate_rank_one_se(fy,rf,h)
    if z1 is not None:R.append(_gate_rec('XSEC_ZERO_PLUS_RANK_1SE',cy[iv],_clip_between(float(z1['residualScale'])*rv,loV,hiV),cd[iv],h,z1))
    strong=[z for z in R if z['preblindStrongEvidence']];adm=[z for z in R if z['preblindAdmissible']];pool=strong or adm
    if pool:chosen=min(pool,key=lambda z:(z['metrics']['mae'],-z['pairedVsNoChange'].get('lower90',-99),-z['metrics'].get('dispersionRatio',0)))
    else:chosen=min(([z for z in R if z['preblindMagnitudeAdmissible']] or R),key=lambda z:(z['metrics']['mae'],-z['metrics'].get('dispersionRatio',0)))
    mode=chosen['name'];layer.pointMode=mode
    if mode in {'ROBUST_AFFINE_SCORE','ROBUST_ORIGIN_SCALE','ROBUST_ORIGIN_SCALE_1SE'}:layer.pointAffineModel=chosen['model']
    elif mode.startswith('XSEC_'):layer.pointXsecModel=chosen['model']
    loC,_,hiC=layer.predict(cs[ic]);loC=np.asarray(loC,float)*qs;hiC=np.asarray(hiC,float)*qs;yy=cy[ic];nc=np.maximum.reduce([loC-yy,yy-hiC,np.zeros(len(yy))]) if len(yy) else np.asarray([],float);target=.60;ql=min(1.,math.ceil((len(nc)+1)*target)/max(1,len(nc)));qadj=float(np.quantile(nc,ql,method='higher')) if len(nc) else 0.;layer.conformalTarget=target;layer.conformalN=int(len(nc));layer.calibrationSplitPolicy='80-85% fits monotone quantile/isotonic and all point-family parameters; early origin dates of maturity-purged 85-90% select the gate-aligned point family against no-change; late origin dates of 85-90% compute conformal widening; 90-100% remains sealed.';layer.pointSelectionAudit={'method':'CHRONOLOGICAL_ORIGIN_DATE_POINT_SELECTION_V1','revision':'GATE_ALIGNED_NO_CHANGE_MAGNITUDE_ONE_SE_V2','splitPolicy':'FIT_80_85__VALIDATE_EARLY_85_90_BY_ORIGIN_DATE__CONFORM_LATE_85_90_BY_ORIGIN_DATE','horizon':h,'fitRows':len(fy),'validationRows':len(iv),'conformalRows':len(ic),'fitDates':len(sp['fitDays']),'validationDates':len(sp['validationDays']),'conformalDates':len(sp['conformalDays']),'fitDateRange':[str(sp['fitDays'][0]),str(sp['fitDays'][-1])],'validationDateRange':[str(sp['validationDays'][0]),str(sp['validationDays'][-1])],'conformalDateRange':[str(sp['conformalDays'][0]),str(sp['conformalDays'][-1])],'dateDisjoint':True,'rowOrderIndependent':True,'sealedLabelsUsed':0,'selectionBaseline':'NO_CHANGE_ZERO_RETURN','selectedFamily':mode,'selectedPreblindAdmissible':bool(chosen['preblindAdmissible']),'selectedPreblindStrongEvidence':bool(chosen['preblindStrongEvidence']),'q50ScaleAudit':qa,'directScoreScaleAudit':sa,'magnitudeFloors':{'dispersionRatio':_gate_floor(h)[0],'p90MagnitudeRatio':_gate_floor(h)[1]},'candidates':{z['name']:{k:v for k,v in z.items() if k not in {'pred','name'}} for z in R},'reason':'selection uses disjoint pre-blind whole-date validation against no-change, temporal stability and the pre-existing magnitude authority floor. One-SE regularization can prefer a non-degenerate zero-centered scale only inside a pre-blind MAE-indistinguishable set. Sealed 90-100% labels are never supplied.'};return layer,iso,max(0.,qadj)

def apply_calibration(score,scen,iso,qadj,origin_dates=None):
    mode=str(getattr(scen,'pointMode','')) if isinstance(scen,_QuantileLayer) else ''
    if mode=='ROBUST_ORIGIN_SCALE_1SE':
        s=np.asarray(score,float);p=np.asarray(iso.predict(s),float);lo0,_,hi0=scen.predict(s);g=float(getattr(scen,'returnShrink',1.));lo=np.asarray(lo0,float)*g;hi=np.asarray(hi0,float)*g;point=_clip_between(_affine_predict(getattr(scen,'pointAffineModel',None),s),lo,hi);return p,np.asarray(point,float),lo-float(qadj),hi+float(qadj),np.full(len(point),int(scen.n),dtype=int)
    if mode in {'XSEC_ZERO_PLUS_RANK','XSEC_ZERO_PLUS_RANK_1SE'}:
        if origin_dates is None:return _gate_before_apply(score,scen,iso,qadj,origin_dates)
        s=np.asarray(score,float);d=np.asarray(origin_dates,dtype=object);p,_,lo,hi,n=_gate_before_apply(s,scen,iso,0.,d);model=getattr(scen,'pointXsecModel',None) or {};point=_clip_between(float(model.get('residualScale',0.))*_xsec_rank_signal(s,d),lo,hi);return np.asarray(p,float),np.asarray(point,float),np.asarray(lo,float)-float(qadj),np.asarray(hi,float)+float(qadj),np.asarray(n)
    return _gate_before_apply(score,scen,iso,qadj,origin_dates)

def _gate_selftest():
    days=np.asarray(sum(([f'2026-01-{d:02d}']*80 for d in range(1,9)),[]),dtype=object);r=np.tile(np.linspace(-1,1,80),8);y=.012*r;bad=_gate_rec('BAD',y,np.zeros(len(y)),days,1);good=_gate_rec('GOOD',y,.010*r,days,1)
    if bad['preblindMagnitudeAdmissible'] is not False or good['preblindAdmissible'] is not True:raise RuntimeError('gate-aligned point selection selftest failed')
    if (_gate_rank_one_se(y,r,1) or {}).get('sealedLabelsUsed')!=0:raise RuntimeError('gate-aligned one-SE selftest failed')
_gate_selftest()

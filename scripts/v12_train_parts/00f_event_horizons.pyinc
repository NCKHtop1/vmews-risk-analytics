_EVENT_H_EXTRA=[]
for _h in HORIZONS:
    for _k in (f'eventPriorAR{_h}',f'eventPriorHit{_h}',f'eventPriorN{_h}',f'eventPriorUncertainty{_h}'):
        _EVENT_H_EXTRA.append(_k)
        if _k not in EVENT_FEATURES:EVENT_FEATURES.append(_k)
        if _k not in EXPERTS['EVENT']:EXPERTS['EVENT'].append(_k)
        if _k not in FEATURES:FEATURES.append(_k)

_event_h_prepare=prepare_articles
_EventHBaseStore=EvidenceFeatureStore

def _pre_benchmark(index_rows,origin_date,k):
    if not index_rows:return None
    dates=[r['date'] for r in index_rows];i=bisect.bisect_left(dates,origin_date)
    if i>=len(dates) or dates[i]!=origin_date or i-k<0:return None
    a=_finite(index_rows[i-k].get('modelClose',index_rows[i-k].get('close')),None);b=_finite(index_rows[i].get('modelClose',index_rows[i].get('close')),None)
    return math.log(b/a) if a and b and a>0 and b>0 else None

def prepare_articles(sentiment,price_store,sector_map,index_rows=None):
    articles,outcomes=_event_h_prepare(sentiment,price_store,sector_map,index_rows);by_id={x.get('id'):x for rows in articles.values() for x in rows if x.get('id') is not None}
    for o in outcomes:
        for h in HORIZONS:
            if isinstance(o.get(f'ar{h}'),(int,float)):o[f'car{h}']=float(o[f'ar{h}'])
        rec=by_id.get(o.get('id'));rows=price_store.get(o.get('symbol')) or []
        if rec and isinstance(rec.get('availableIndex'),int):
            i=rec['availableIndex']
            for k in (1,2,5):
                if i-k>=0:
                    a=_finite(rows[i-k].get('modelClose',rows[i-k].get('close')),None);b=_finite(rows[i].get('modelClose',rows[i].get('close')),None)
                    if a and b and a>0 and b>0:
                        sr=math.log(b/a);br=_pre_benchmark(index_rows,rec['availableDate'],k);o[f'preAR{k}']=sr-br if isinstance(br,(int,float)) else sr
    return articles,outcomes

class _HorizonOutcomePrior:
    # Fixed conjugate prior strengths are selected before replay. Sector shrinkage is deliberately disabled until an as-of sector-membership archive exists.
    MARKET_AR_KAPPA=16.0;STOCK_AR_KAPPA=6.0
    MARKET_HIT_ALPHA=4.0;MARKET_HIT_BETA=4.0;STOCK_HIT_KAPPA=6.0
    def __init__(self,outcomes,h):
        self.h=h;groups=defaultdict(list);ak=f'ar{h}';mk=f'matureDate{h}'
        for x in outcomes:
            ar=x.get(ak);mature=x.get(mk)
            if not isinstance(ar,(int,float)) or not math.isfinite(ar) or not mature:continue
            # Never group historical labels by the current-2026 sector reference. Market and stock identities are PIT-safe here.
            for key in [('MARKET',x['event']),('STOCK',x['symbol'],x['event'])]:groups[key].append((mature,float(ar)))
        self.groups={}
        for key,vals in groups.items():
            vals.sort();dates=[];sums=[0.0];sumsq=[0.0];pos=[0]
            for d,v in vals:
                dates.append(d);sums.append(sums[-1]+v);sumsq.append(sumsq[-1]+v*v);pos.append(pos[-1]+(1 if v>0 else 0))
            self.groups[key]=(dates,sums,sumsq,pos)
    def _q(self,key,date):
        z=self.groups.get(key)
        if not z:return None
        dates,sums,sumsq,pos=z;n=bisect.bisect_right(dates,date)
        if n<=0:return None
        mean=sums[n]/n;var=max(1e-8,(sumsq[n]-n*mean*mean)/max(1,n-1)) if n>1 else max(1e-6,(.018*math.sqrt(self.h))**2)
        return {'n':n,'sum':sums[n],'pos':pos[n],'mean':mean,'var':var,'hit':pos[n]/n}
    @staticmethod
    def _normal_update(obs,prior_mean,kappa):
        if not obs:return {'mean':float(prior_mean),'n':0,'unc':1.0/math.sqrt(max(1.0,kappa))}
        n=float(obs['n']);post=(obs['sum']+kappa*prior_mean)/(n+kappa);unc=math.sqrt(max(obs['var'],1e-8)/(n+kappa));return {'mean':float(post),'n':int(n),'unc':float(unc)}
    @staticmethod
    def _beta_update(obs,prior_mean,prior_strength):
        a=max(1e-6,float(prior_mean)*prior_strength);b=max(1e-6,(1.0-float(prior_mean))*prior_strength)
        if obs:a+=obs['pos'];b+=obs['n']-obs['pos']
        mean=a/(a+b);var=(a*b)/(((a+b)**2)*(a+b+1.0));return {'mean':float(mean),'sd':float(math.sqrt(max(0.0,var)))}
    def hierarchical(self,symbol,sector,event,date):
        market=self._q(('MARKET',event),date);stock=self._q(('STOCK',symbol,event),date)
        mar_ar=self._normal_update(market,0.0,self.MARKET_AR_KAPPA);stk_ar=self._normal_update(stock,mar_ar['mean'],self.STOCK_AR_KAPPA)
        mar_hit=self._beta_update(market,.5,self.MARKET_HIT_ALPHA+self.MARKET_HIT_BETA);stk_hit=self._beta_update(stock,mar_hit['mean'],self.STOCK_HIT_KAPPA)
        source_n=(stock or market or {'n':0})['n'];unc=max(stk_ar['unc'],stk_hit['sd'])
        return {'mean':stk_ar['mean'],'hit':stk_hit['mean'],'n':int(source_n),'uncertainty':float(unc),'levels':{'stock':int((stock or {'n':0})['n']),'sector':0,'market':int((market or {'n':0})['n'])},'sectorPITStatus':'ABSTAIN'}

class EvidenceFeatureStore(_EventHBaseStore):
    def __init__(self,articles_by_symbol,outcomes,sector_map):
        super().__init__(articles_by_symbol,outcomes,sector_map);self.horizonPriors={h:_HorizonOutcomePrior(outcomes,h) for h in HORIZONS};self.hierarchyPolicy='PIT-safe Normal/Beta-Binomial Market→Stock shrinkage. Sector level is ABSTAIN until a dated historical membership archive exists.'
    def features(self,symbol,date):
        out=super().features(symbol,date);sec=self.sector_map.get(symbol,'OTHER');st=self.stock.get(symbol,Timeline([]));latest=st.latest(date)
        # Override the legacy stock→sector→market sentiment shrinkage: current sector taxonomy is not historical PIT.
        s20=self._agg(st.window(date,20));m20=self._agg(self.market.window(date,20));ws=s20['n']/(s20['n']+5);out['hierSent20']=ws*s20['sent']+(1-ws)*m20['sent']
        for h in HORIZONS:
            if latest:pr=self.horizonPriors[h].hierarchical(symbol,sec,latest['event'],date)
            else:pr={'mean':0.0,'hit':.5,'n':0,'uncertainty':1.0}
            out[f'eventPriorAR{h}']=pr['mean'];out[f'eventPriorHit{h}']=pr['hit']-.5;out[f'eventPriorN{h}']=math.log1p(pr['n'])/5;out[f'eventPriorUncertainty{h}']=min(1.0,float(pr['uncertainty']))
        return out

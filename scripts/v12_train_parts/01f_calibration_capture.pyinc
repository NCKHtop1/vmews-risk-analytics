CALIBRATION_CAPTURE=[]
_quantile_calibrate_before_capture=calibrate

def calibrate(cal_y,cal_score,conform_y,conform_score,cal_dates=None,conform_dates=None):
    out=_quantile_calibrate_before_capture(cal_y,cal_score,conform_y,conform_score,cal_dates,conform_dates);CALIBRATION_CAPTURE.append(out);return out

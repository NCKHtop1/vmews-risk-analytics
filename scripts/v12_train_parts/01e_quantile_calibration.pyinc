from sklearn.ensemble import GradientBoostingRegressor as _QuantileGBR

class _QuantileLayer:
    def __init__(self,models,method,n,score_min,score_max):self.models=models;self.method=method;self.n=int(n);self.scoreMin=float(score_min);self.scoreMax=float(score_max)
    def predict(self,score):
        x=np.asarray(score,float).reshape(-1,1);q20=np.asarray(self.models[.2].predict(x),float);q50=np.asarray(self.models[.5].predict(x),float);q80=np.asarray(self.models[.8].predict(x),float);stack=np.sort(np.column_stack([q20,q50,q80]),axis=1);return stack[:,0],stack[:,1],stack[:,2]

def _fit_quantile_model(alpha,x,y):
    try:
        from lightgbm import LGBMRegressor
        m=LGBMRegressor(objective='quantile',alpha=alpha,n_estimators=120,learning_rate=.035,num_leaves=9,max_depth=3,min_child_samples=120,reg_lambda=3.,reg_alpha=.2,subsample=.9,colsample_bytree=1.0,random_state=1200+int(alpha*100),n_jobs=2,verbosity=-1);m.fit(x,y);return m,'LIGHTGBM_QUANTILE'
    except Exception:
        m=_QuantileGBR(loss='quantile',alpha=alpha,n_estimators=100,learning_rate=.04,max_depth=2,min_samples_leaf=100,random_state=1200+int(alpha*100));m.fit(x,y);return m,'SKLEARN_GBR_QUANTILE'

def calibrate(cal_y,cal_score,conform_y,conform_score):
    x=np.asarray(cal_score,float).reshape(-1,1);models={};methods=[]
    for a in (.2,.5,.8):m,method=_fit_quantile_model(a,x,np.asarray(cal_y,float));models[a]=m;methods.append(method)
    layer=_QuantileLayer(models,methods[0] if len(set(methods))==1 else '+'.join(sorted(set(methods))),len(cal_y),np.min(cal_score),np.max(cal_score));iso=IsotonicRegression(y_min=.02,y_max=.98,out_of_bounds='clip');iso.fit(cal_score,(np.asarray(cal_y)>0).astype(float));lo,med,hi=layer.predict(conform_score);cy=np.asarray(conform_y,float);nonconf=np.maximum.reduce([lo-cy,cy-hi,np.zeros(len(cy))]);target=.60;qlevel=min(1.0,math.ceil((len(nonconf)+1)*target)/max(1,len(nonconf)));qadj=float(np.quantile(nonconf,qlevel,method='higher')) if len(nonconf) else 0.0;layer.conformalTarget=target;layer.conformalN=len(nonconf);return layer,iso,max(0.0,qadj)

def apply_calibration(score,scen,iso,qadj):
    p=np.asarray(iso.predict(score),float)
    if isinstance(scen,_QuantileLayer):
        lo,med,hi=scen.predict(score);lo=lo-float(qadj);hi=hi+float(qadj);ns=np.full(len(med),int(scen.n),dtype=int);return p,med,lo,hi,ns
    # Legacy fallback retained only to read an old artifact; new training must use _QuantileLayer.
    med=[];lo=[];hi=[];ns=[]
    for x in score:
        b=bfind(scen,x);med.append(b['medianReturn']);lo.append(b['q20']-qadj);hi.append(b['q80']+qadj);ns.append(b['n'])
    return p,np.asarray(med),np.asarray(lo),np.asarray(hi),np.asarray(ns)

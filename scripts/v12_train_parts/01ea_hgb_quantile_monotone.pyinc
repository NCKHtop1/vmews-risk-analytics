# LightGBM does not support monotone_constraints with objective='quantile'.
# The previous wrapper always emitted a LightGBM fatal diagnostic and then fell back to HGB.
# Make the actually-supported monotone quantile estimator explicit and deterministic.
def _fit_quantile_model(alpha,x,y):
    m=HistGradientBoostingRegressor(
        loss='quantile',quantile=alpha,max_iter=100,learning_rate=.04,max_depth=2,
        min_samples_leaf=100,l2_regularization=1.0,monotonic_cst=[1],
        random_state=1200+int(alpha*100)
    )
    m.fit(x,y)
    return m,'SKLEARN_HGB_QUANTILE_MONOTONE'

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "regions": ["sin1"],
  "rewrites": [
    {"source": "/api/ews", "destination": "/api/final"}
  ],
  "functions": {
    "api/final.py": {
      "maxDuration": 30,
      "excludeFiles": "{model/**,docs/**,**/*.md,PORTFOLIO_CV_TEXT.md}"
    },
    "api/live.py": {
      "maxDuration": 30,
      "excludeFiles": "{model/**,docs/**,**/*.md,PORTFOLIO_CV_TEXT.md}"
    },
    "api/ews.py": {
      "maxDuration": 30,
      "excludeFiles": "{model/**,docs/**,**/*.md,PORTFOLIO_CV_TEXT.md}"
    },
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{model/**,docs/**,**/*.md,PORTFOLIO_CV_TEXT.md}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=120"}
      ]
    }
  ]
}
